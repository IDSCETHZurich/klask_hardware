{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug camera_node (ROS2)",
            "type": "debugpy",
            "request": "launch",
            "module": "klask_imaging_pkg.camera_node",
            "args": [
                "--ros-args",
                "--params-file",
                "${workspaceFolder}/src/klask_imaging_pkg/config/camera_node_params.yaml"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Debug image_viewer (ROS2)",
            "type": "debugpy",
            "request": "launch",
            "module": "klask_imaging_pkg.image_viewer",
            "args": [
                "--ros-args",
                "--params-file",
                "${workspaceFolder}/src/klask_imaging_pkg/config/image_viewer_params.yaml"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Debug image_downscaler (ROS2)",
            "type": "debugpy",
            "request": "launch",
            "module": "klask_imaging_pkg.image_downscaler_node",
            "args": [
                "--ros-args",
                "--params-file",
                "${workspaceFolder}/src/klask_imaging_pkg/config/image_downscaler_params.yaml"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Debug image_viewer → downscaled (ROS2)",
            "type": "debugpy",
            "request": "launch",
            "module": "klask_imaging_pkg.image_viewer",
            "args": [
                "--ros-args",
                "-p",
                "board_image_topic:=board_image_downscaled/compressed",
                "-p",
                "show_fps_overlay:=false"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Debug state_estimator_node (ROS2)",
            "type": "debugpy",
            "request": "launch",
            "module": "klask_state_estimator_pkg.state_estimator_node",
            "args": [
                "--ros-args",
                "--params-file",
                "${workspaceFolder}/src/klask_state_estimator_pkg/config/state_estimator_params.yaml"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Launch ODrive Nodes (No Motor Commander)",
            "type": "node-terminal",
            "request": "launch",
            "command": "source install/setup.bash && ros2 launch klask_motor_commander_pkg motors_launch.py player:=both start_commander:=false",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build_workspace",
        },
        {
            "name": "Debug Motor Commander (C++ with launch)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/install/klask_motor_commander_pkg/lib/klask_motor_commander_pkg/klask_motor_commander",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "ROS_DOMAIN_ID",
                    "value": "0"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build_workspace"
        },
    ],
    "compounds": [
        {
            "name": "Camera + Downscaler + Viewer",
            "configurations": [
                "Debug camera_node (ROS2)",
                "Debug image_downscaler (ROS2)",
                "Debug image_viewer → downscaled (ROS2)"
            ],
            "stopAll": true
        }
    ]
}
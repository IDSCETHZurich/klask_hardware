{
    "name": "KLASK SDK",
    "image": "klask_ros_sdk:latest",
    "workspaceFolder": "/root/ros2_ws",
    "workspaceMount": "source=${localWorkspaceFolder}/ros/src,target=/root/ros2_ws/src,type=bind",
    "runArgs": [
        "--rm",
        "--env=DISPLAY",
        "--env=QT_X11_NO_MITSHM=1",
        "--device=/dev/video0:/dev/video0",
        "--network=host",
        "--cap-add=NET_ADMIN",
        "--cap-add=NET_RAW", 
        "--name=klask_ros_sdk_container_latest"
    ],
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",

        "source=klask_build,target=/root/ros2_ws/build,type=volume",
        "source=klask_install,target=/root/ros2_ws/install,type=volume",
        "source=klask_log,target=/root/ros2_ws/log,type=volume",

        "source=${localWorkspaceFolder}/ros/.vscode,target=/root/ros2_ws/.vscode,type=bind"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-vscode.cpptools-extension-pack"
            ]
        }
    }
}